---
/**
 * MAIN LANDING PAGE - CV GREEN FRESH CIPANAS
 * Mode: Full Astro (Zero Hydration Strategis)
 * Update: SEO Optimization & Schema Markup (Dengan offers)
 */
import MainLayout from '@/layouts/MainLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

// Komponen Pendukung
import Hero from '@/components/Hero.astro';
import WhoWeAre from '@/components/WhoWeAre.astro';
import CashFlow from '@/components/CashFlow.astro';
import EconomicImpact from '@/components/EconomicImpact.astro';
import VisualGallery from '@/components/VisualGallery.astro';

// Icons & Data
import { MapPin, ChevronRight } from 'lucide-react';
import { jabodetabekCities } from '@/data/cities';

// SEO Optimasi
const title = "Distributor Sayuran & Supplier Sayuran Segar Terpercaya - CV Green Fresh Cipanas";
const description = "Distributor sayuran dan supplier sayuran segar Grade A untuk Hotel, Restoran, dan Catering. Distribusi langsung dari petani Cipanas dengan sistem logistik 24 jam. Terpercaya di Jabodetabek.";
const keywords = "distributor sayuran, supplier sayuran, supplier sayur, distributor sayur segar, supplier sayuran cipanas, distributor sayuran jakarta";

// Base URL
const baseUrl = "https://greenfresh.co.id";

// Schema Markup (Dengan offers di setiap product)
const schemaMarkup = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "CV Green Fresh Cipanas",
  "description": "Distributor sayuran dan supplier sayuran segar terpercaya di Cipanas, melayani Jabodetabek",
  "image": `${baseUrl}/og-image.jpg`,
  "logo": `${baseUrl}/logo.png`,
  "url": baseUrl,
  "telephone": "+62-812-3456-7890",
  "email": "info@greenfresh.co.id",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Jl. Raya Cipanas No. 123",
    "addressLocality": "Cipanas",
    "addressRegion": "Jawa Barat",
    "postalCode": "43253",
    "addressCountry": "Indonesia"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "-6.7253",
    "longitude": "107.0394"
  },
  "openingHours": "Mo-Su 05:00-17:00",
  "sameAs": [
    "https://www.instagram.com/greenfreshcipanas",
    "https://www.facebook.com/greenfreshcipanas"
  ],
  "priceRange": "$$",
  "servesCuisine": "Indonesian Fresh Vegetables",
  "areaServed": {
    "@type": "City",
    "name": "Jabodetabek"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Distribusi Sayuran Segar",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Product",
          "name": "Sayuran Daun Segar",
          "description": "Supplier sayuran daun segar grade A",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "IDR",
            "availability": "https://schema.org/InStock",
            "url": `${baseUrl}/produk/sayuran-daun`
          }
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Product",
          "name": "Sayuran Buah Segar",
          "description": "Distributor sayuran buah segar berkualitas",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "IDR",
            "availability": "https://schema.org/InStock",
            "url": `${baseUrl}/produk/sayuran-buah`
          }
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Product",
          "name": "Paket Sayuran Restoran",
          "description": "Paket suplai sayuran untuk restoran dan hotel",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "IDR",
            "availability": "https://schema.org/InStock",
            "url": `${baseUrl}/produk/paket-restoran`
          }
        }
      }
    ]
  },
  "potentialAction": {
    "@type": "OrderAction",
    "target": `${baseUrl}/pesan`,
    "deliveryMethod": "https://schema.org/OnSitePickup"
  },
  "makesOffer": [
    {
      "@type": "Offer",
      "name": "Distribusi Sayuran 24 Jam",
      "description": "Layanan distribusi sayuran segar 24 jam untuk Jabodetabek",
      "price": "0",
      "priceCurrency": "IDR"
    },
    {
      "@type": "Offer",
      "name": "Supplier Sayuran Hotel",
      "description": "Pemasok sayuran premium untuk hotel bintang",
      "price": "0",
      "priceCurrency": "IDR"
    }
  ]
};
---

<MainLayout title={title} description={description} keywords={keywords}>
  <head>
    <!-- Schema Markup -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={baseUrl} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={baseUrl} />
    <meta property="og:image" content={`${baseUrl}/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${baseUrl}/twitter-image.jpg`} />
    
    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <link rel="sitemap" href="/sitemap.xml" />
  </head>
  
  <div class="bg-[#fcfdfc] text-[#052c17] font-sans selection:bg-green-100 reveal-container">
    <Header />

    <main>
      <Hero />

      <!-- Breadcrumb untuk SEO -->
      <nav class="max-w-7xl mx-auto px-4 py-3 text-sm text-slate-500" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-green-700">Beranda</a></li>
          <li><span class="text-slate-300">/</span></li>
          <li><span class="text-green-700 font-medium">Distributor & Supplier Sayuran</span></li>
        </ol>
      </nav>

      <section class="reveal-up bg-white border-b-2 border-green-50">
        <WhoWeAre />
      </section>

      <!-- Section dengan target keyword di heading -->
      <section class="py-16 md:py-24 bg-white border-b-2 border-green-50 reveal-up">
        <div class="max-w-4xl mx-auto px-6">
          <article class="prose prose-slate prose-lg max-w-none">
            <div class="flex items-center gap-3 mb-8">
              <div class="w-10 h-[2px] bg-[#15803d]"></div>
              <h3 class="text-[10px] font-black text-[#15803d] uppercase tracking-[0.5em]">Industry Leadership</h3>
            </div>
            
            <h1 class="text-3xl md:text-5xl font-black uppercase text-[#052c17] mb-8 tracking-tighter leading-none">
              Distributor & Supplier Sayuran Segar <span class="text-green-600">Terintegrasi.</span>
            </h1>

            <div class="space-y-6 text-slate-600 leading-relaxed font-medium">
              <p>
                Sebagai <strong class="text-green-800">supplier sayuran</strong> utama yang berbasis di dataran tinggi Cipanas, CV Green Fresh Cipanas telah mendedikasikan diri untuk merevolusi rantai pasok agrikultur di Indonesia. Kami memahami bahwa tantangan terbesar bagi operasional restoran, hotel, dan katering adalah inkonsistensi kualitas dan fluktuasi harga pasar yang tidak menentu. Dengan mengadopsi model <em>Direct-Farming</em>, kami menjamin bahwa setiap komoditas yang tiba di dapur Anda adalah hasil panen terbaik yang diproses melalui standar kurasi ketat.
              </p>

              <p>
                Keunggulan kami terletak pada integrasi hulu ke hilir. Lahan pertanian kami di Cipanas dikelola dengan teknik budidaya modern yang memperhatikan aspek kesehatan tanah dan keberlanjutan. Hal ini memungkinkan kami untuk menyediakan pasokan sayuran Grade A secara stabil sepanjang tahun, bahkan di tengah tantangan cuaca ekstrem. Sebagai <strong class="text-green-800">distributor sayuran segar</strong> terpercaya, kami memangkas jalur distribusi tradisional yang panjang, sehingga kesegaran produk (<em>crispness</em>) tetap terjaga maksimal saat pengiriman.
              </p>

              <div class="grid md:grid-cols-2 gap-8 my-12 p-8 bg-green-50 rounded-3xl border border-green-100 shadow-sm">
                <div>
                  <h4 class="text-[#052c17] font-black uppercase text-sm mb-3 tracking-wider">Komitmen Kualitas</h4>
                  <p class="text-sm">Setiap unit komoditas melewati proses sortasi manual dan pembersihan standar industri guna meminimalisir <em>rejection rate</em> di gudang mitra.</p>
                </div>
                <div>
                  <h4 class="text-[#052c17] font-black uppercase text-sm mb-3 tracking-wider">Efisiensi Finansial</h4>
                  <p class="text-sm">Kami mendukung pertumbuhan bisnis mitra melalui fleksibilitas sistem pembayaran (Term of Payment) dan transparansi faktur pajak PKP resmi.</p>
                </div>
              </div>

              <p>
                Logistik adalah nadi dari layanan kami. Dengan sistem <strong class="text-green-800">distribusi sayur 24 jam</strong>, armada kami bergerak setiap subuh untuk menembus titik-titik vital di Jakarta, Bogor, Depok, Tangerang, Bekasi, hingga Cikarang. Kami tidak hanya sekadar mengirimkan barang, kami memberikan kepastian operasional bagi tim purchasing dan chef agar mereka dapat fokus pada kreasi menu tanpa khawatir akan kendala bahan baku.
              </p>
              
              <!-- Target keyword section -->
              <div class="bg-white p-6 rounded-xl border border-green-200 shadow-sm my-8">
                <h2 class="text-xl font-bold text-[#052c17] mb-3">Distributor & Supplier Sayuran Terpercaya</h2>
                <p class="text-sm">
                  CV Green Fresh Cipanas adalah <strong>distributor sayuran</strong> dan <strong>supplier sayuran</strong> terpercaya yang melayani kebutuhan bisnis kuliner di Jabodetabek dengan sistem logistik 24 jam.
                </p>
              </div>

              <p>
                Memilih CV Green Fresh Cipanas berarti memilih stabilitas, transparansi, dan kualitas prima. Kami mengundang Anda untuk mendiskusikan kebutuhan suplai spesifik bisnis Anda dan bergabung dalam jaringan kemitraan profesional kami yang telah dipercaya oleh ratusan unit bisnis kuliner di Jabodetabek.
              </p>
            </div>
          </article>
        </div>
      </section>

      <section class="py-16 md:py-24 bg-[#f8faf8] border-b-2 border-green-100 reveal-up">
        <div class="max-w-[1800px] mx-auto px-6">
          <div class="flex flex-col md:flex-row items-end justify-between mb-12 gap-6">
            <div class="space-y-3">
              <div class="flex items-center gap-2">
                <span class="w-8 h-[1px] bg-[#15803d]"></span>
                <h3 class="text-[10px] font-black text-[#15803d] uppercase tracking-[0.4em]">Operational Excellence</h3>
              </div>
              <h2 class="text-4xl lg:text-6xl font-black uppercase tracking-tighter text-[#052c17]">Dokumentasi Lahan.</h2>
              <p class="text-slate-600 font-bold text-sm md:text-lg">Transparansi proses dari sortasi hingga pengiriman akhir.</p>
            </div>
          </div>
          <VisualGallery />
        </div>
      </section>

      <section class="reveal-up">
        <CashFlow />
        <EconomicImpact />
      </section>

      <section class="py-20 md:py-32 bg-[#fcfdfc] border-t-2 border-green-100">
        <div class="max-w-[1800px] mx-auto px-6">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-8 reveal-up">
            <div class="space-y-4 text-left">
              <div class="flex items-center gap-3">
                 <div class="w-10 h-[2px] bg-[#15803d]"></div>
                 <h3 class="text-[10px] font-black text-[#15803d] uppercase tracking-[0.5em]">Logistik & Jangkauan</h3>
              </div>
              <h2 class="text-4xl lg:text-7xl font-black uppercase tracking-tighter text-[#052c17]">Wilayah <span class="text-green-600">Pengiriman.</span></h2>
            </div>
            <p class="max-w-md text-slate-600 font-bold leading-relaxed border-l-4 border-green-500/20 pl-6 text-left">
              Sistem distribusi mandiri melayani berbagai kawasan bisnis strategis setiap hari dengan armada standar pangan.
            </p>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6 reveal-up">
            {jabodetabekCities.slice(0, 18).map((city) => (
              <a 
                href={`/kota/${city.slug}`} 
                class="relative group overflow-hidden p-6 rounded-2xl border-2 border-green-100 bg-white shadow-sm transition-all duration-300 hover:border-[#15803d] hover:shadow-md text-left"
              >
                <div class="absolute -right-2 -top-2 w-12 h-12 bg-green-50 rounded-full opacity-50 group-hover:bg-green-100 transition-colors"></div>

                <div class="relative z-10 flex flex-col items-start gap-4">
                  <div class="p-2.5 bg-green-50 rounded-xl text-[#15803d] border border-green-100 group-hover:bg-[#15803d] group-hover:text-white transition-all">
                    <MapPin size={18} />
                  </div>
                  <div>
                    <span class="text-[11px] font-black uppercase tracking-widest text-[#052c17] block mb-1">
                      {city.name}
                    </span>
                    <div class="flex items-center gap-1 text-[#15803d] text-[8px] font-black uppercase opacity-60 group-hover:opacity-100 transition-opacity">
                      <span>Lihat Detail</span>
                      <ChevronRight size={10} />
                    </div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</MainLayout>

<style>
  /* 1. STATE AWAL: Tampil default (Anti-Blank Putih) */
  .reveal-up {
    opacity: 1;
    transform: translateY(0);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* 2. STATE ANIMASI: Sembunyikan hanya jika JS Aktif */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js-enabled) .reveal-up {
      opacity: 0;
      transform: translateY(30px);
    }
  }

  /* 3. STATE AKTIF SAAT SCROLL */
  :global(.is-visible) .reveal-up {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }
</style>

<script>
  // Aktifkan mode JS untuk animasi CSS
  document.documentElement.classList.add('js-enabled');

  const setupObserver = () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    }, { 
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    });

    document.querySelectorAll('.reveal-up').forEach(el => observer.observe(el));
  };

  setupObserver();
  // Mendukung Astro View Transitions
  document.addEventListener('astro:after-swap', setupObserver);
</script>