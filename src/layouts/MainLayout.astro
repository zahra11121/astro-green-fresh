---
// src/layouts/MainLayout.astro

// 1. Set ke true untuk mengaktifkan mode simulasi mati / maintenance
const isMaintenance = true; 

if (isMaintenance) {
  Astro.response.status = 503;
  Astro.response.statusText = "Service Unavailable";
  Astro.response.headers.set('Retry-After', '3600');
  Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, max-age=0');
}

const { title = "Web Server" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{isMaintenance ? "HTTP Error 503 - Service Unavailable" : title}</title>
    
    {isMaintenance && (
        <style is:inline>
            /* CSS minimalis & clean, diletakkan inline khusus saat maintenance */
            html, body {
                margin: 0;
                padding: 0;
                width: 100%;
                height: 100%;
                background-color: #f4f6f9;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                color: #333;
            }
            .error-wrapper {
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                padding: 20px;
                box-sizing: border-box;
            }
            .error-card {
                background: #ffffff;
                max-width: 550px;
                width: 100%;
                padding: 40px;
                border-radius: 8px;
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
                border: 1px solid #e1e8ed;
            }
            .error-header {
                text-align: center;
                margin-bottom: 25px;
            }
            .icon-warning {
                font-size: 3rem;
                margin-bottom: 10px;
            }
            .error-header h1 {
                font-size: 1.8rem;
                color: #d9534f;
                margin: 0;
                font-weight: 700;
            }
            .subtitle {
                color: #72777d;
                font-size: 1rem;
                margin-top: 5px;
                text-transform: uppercase;
                letter-spacing: 1px;
            }
            hr {
                border: 0;
                border-top: 1px solid #e1e8ed;
                margin: 20px 0;
            }
            .error-body p {
                font-size: 1rem;
                line-height: 1.6;
                color: #4a5056;
                margin-bottom: 15px;
            }
            .technical-details {
                background-color: #f8f9fa;
                border-left: 4px solid #d9534f;
                padding: 15px 20px;
                margin-top: 30px;
                border-radius: 0 4px 4px 0;
            }
            .technical-details p {
                margin: 0 0 8px 0;
                font-size: 0.9rem;
                color: #4a5056;
            }
            .technical-details ul {
                margin: 0;
                padding-left: 20px;
                font-size: 0.85rem;
                color: #6c757d;
            }
            .technical-details li {
                margin-bottom: 5px;
            }
            code {
                font-family: monospace;
                background-color: #eaeaea;
                padding: 2px 6px;
                border-radius: 3px;
                color: #bd4147;
            }
        </style>
    )}
</head>
<body>
    {isMaintenance ? (
        <div class="error-wrapper">
            <div class="error-card">
                <div class="error-header">
                    <div class="icon-warning">⚠️</div>
                    <h1>HTTP Error 503</h1>
                    <p class="subtitle">Service Temporarily Unavailable</p>
                </div>
                
                <hr />
                
                <div class="error-body">
                    <p>The server is currently unable to handle the request due to a temporary overloading or maintenance of the server.</p>
                    <p>Your request cannot be processed at this time. Please try reloading the page in a few minutes.</p>
                </div>
                
                <div class="technical-details">
                    <p><strong>Technical Information:</strong></p>
                    <ul>
                        <li>Status: <code>503 Service Unavailable</code></li>
                        <li>Cause: <code>Database Connection Pool Exhausted</code></li>
                        <li>Activity ID: <code>ERR_CONN_TIMEOUT_{Math.floor(Math.random() * 9000) + 1000}</code></li>
                    </ul>
                </div>
            </div>
        </div>
    ) : (
        <>
            <header>
                {/* Navigasi normal Anda */}
            </header>
            <main>
                <slot /> 
            </main>
            <footer>
                {/* Footer normal Anda */}
            </footer>
        </>
    )}
</body>
</html>

<style>
    /* CSS untuk halaman normal diletakkan di sini. 
       Ketika isMaintenance = true, CSS di bawah ini tidak akan dibaca oleh browser pengunjung.*/
</style>