---
// MainLayout.astro
import "../styles/global.css";

const { 
  title = "Greenfresh.co.id", 
  description = "Supplier Sayur Segar B2B", 
  canonical 
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site);

const waMessage = encodeURIComponent("Halo Green Fresh, saya ingin melakukan pemesanan sayuran. Mohon informasi stok harian dan prosedur order untuk wilayah saya. Terima kasih.");
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&display=swap" rel="stylesheet">
    
    <slot name="head" />
  </head>
  <body class="antialiased font-sans">
    <slot />

    <div class="wa-widget">
      <div id="wa-menu" class="wa-menu">
        <div class="wa-header">
          <strong>Hubungi Admin Green Fresh</strong>
          <p>Silakan pilih admin untuk memesan:</p>
        </div>
        <div class="wa-list">
          <a href={`https://wa.me/6287700592999?text=${waMessage}`} target="_blank" rel="noopener noreferrer" class="wa-item">
            <div class="wa-avatar">A1</div>
            <span>Admin 1</span>
          </a>
          <a href={`https://wa.me/6287780937884?text=${waMessage}`} target="_blank" rel="noopener noreferrer" class="wa-item">
            <div class="wa-avatar">A2</div>
            <span>Admin 2</span>
          </a>
        </div>
      </div>

      <button id="wa-toggle" class="wa-main-button" aria-label="WhatsApp Contact">
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
      </button>
    </div>

    <script>
      const btn = document.getElementById('wa-toggle');
      const menu = document.getElementById('wa-menu');

      if (btn && menu) {
        btn.addEventListener('click', () => {
          menu.classList.toggle('active');
        });

        document.addEventListener('click', (e) => {
          if (!btn.contains(e.target as Node) && !menu.contains(e.target as Node)) {
            menu.classList.remove('active');
          }
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --font-geist-sans: 'Geist', sans-serif;
    --font-geist-mono: 'Geist Mono', monospace;
  }
  body {
    font-family: var(--font-geist-sans);
  }

  .wa-widget {
    position: fixed;
    bottom: 30px;
    right: 30px;
    z-index: 9999;
  }

  .wa-menu {
    position: absolute;
    bottom: 80px;
    right: 0;
    width: 280px;
    background: white;
    border-radius: 16px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    overflow: hidden;
    transform: translateY(20px);
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .wa-menu.active {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .wa-header {
    background: #22c55e;
    color: white;
    padding: 15px;
  }

  .wa-header p {
    font-size: 12px;
    margin: 5px 0 0;
    opacity: 0.9;
  }

  .wa-list {
    padding: 10px;
  }

  .wa-item {
    display: flex;
    align-items: center;
    padding: 12px;
    text-decoration: none;
    color: #333;
    gap: 12px;
    border-radius: 10px;
    transition: background 0.2s;
  }

  .wa-item:hover {
    background: #f0fdf4;
  }

  .wa-avatar {
    width: 35px;
    height: 35px;
    background: #e5e7eb;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: bold;
    color: #16a34a;
  }

  .wa-main-button {
    width: 60px;
    height: 60px;
    background-color: #22c55e;
    color: white;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(34, 197, 94, 0.4);
    transition: transform 0.3s;
  }

  .wa-main-button:hover {
    transform: scale(1.1);
  }
</style>